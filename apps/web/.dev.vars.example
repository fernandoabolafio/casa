# Copy to apps/web/.dev.vars (gitignored). Used by `react-router dev`.
# If Vite falls back to 5174, either free 5173 or set BETTER_AUTH_URL to that origin.

BETTER_AUTH_SECRET=dev-only-change-me-use-at-least-32-chars
BETTER_AUTH_URL=http://localhost:5173

