# Copy to apps/web/.dev.vars (gitignored). Used by `react-router dev`.
# BETTER_AUTH_SECRET is the only auth secret. URLs are vars (also in wrangler.jsonc).
# If Vite falls back to 5174, set both URLs to that origin or free 5173.

BETTER_AUTH_SECRET=dev-only-change-me-use-at-least-32-chars
BETTER_AUTH_URL=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173

# Local generate (already set as wrangler secrets in production):
# OPENAI_API_KEY=
# GEMINI_API_KEY=
