{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "casa-web",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  // Public URLs go here. API keys do not: `wrangler secret put OPENAI_API_KEY`
  // and `wrangler secret put GEMINI_API_KEY` (same as joga-app).
  "vars": {}
}
