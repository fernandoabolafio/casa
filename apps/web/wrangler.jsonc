{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "casa-web",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  // Adding routes infers workers_dev=false unless this stays true.
  // Keep casa-web.hi-c3a.workers.dev for existing outreach links.
  "workers_dev": true,
  "routes": [
    { "pattern": "seeyourroom.app", "custom_domain": true },
    { "pattern": "www.seeyourroom.app", "custom_domain": true }
  ],
  // Vars (not secrets). Auth URLs are the custom domain.
  // Secrets: wrangler secret put BETTER_AUTH_SECRET
  //           wrangler secret put OPENAI_API_KEY
  //           wrangler secret put GEMINI_API_KEY
  "vars": {
    "BETTER_AUTH_URL": "https://seeyourroom.app",
    "PUBLIC_WEB_URL": "https://seeyourroom.app"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "casa",
      "database_id": "06906658-5515-4f5d-9064-b5a65a01bc2e",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "casa-images"
    }
  ],
  "workflows": [
    {
      "name": "casa-generate-scene",
      "binding": "GENERATE_SCENE",
      "class_name": "GenerateSceneWorkflow"
    }
  ]
}
