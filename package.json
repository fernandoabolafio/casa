{
  "name": "casa",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @casa/web dev",
    "dev:web": "pnpm --filter @casa/web dev",
    "dev:canvas": "pnpm --filter @casa/canvas dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "deploy:web": "pnpm --filter @casa/web deploy",
    "deploy:canvas": "pnpm --filter @casa/canvas deploy"
  }
}
